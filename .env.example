# Backend environment variables

# Agent workspace root
NOMOCLAW_ROOT_DIR=$HOME/.nomoclaw

# MySQL
MYSQL_URL=jdbc:mysql://localhost:3306/nomoclaw?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USER=YOUR_MYSQL_USER
MYSQL_PASSWORD=change_me

# LLM provider key (optional, required when using qwen provider)
DASHSCOPE_API_KEY=

# Optional but strongly recommended in production:
# - set this key => model apiKey saved as encrypted ciphertext (enc:)
# - leave empty => model apiKey saved as plaintext wrapper (plain:)
LLM_MODEL_CONFIG_ENCRYPTION_KEY=replace_with_a_strong_random_key

# Feishu / DingTalk channel credentials (optional)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=
