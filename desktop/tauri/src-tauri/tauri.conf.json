{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NomoClaw",
  "version": "0.1.0",
  "identifier": "NomoClaw",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NomoClaw",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.ico",
      "../../../build/macos/NomoClaw.icns",
      "icons/icon.png"
    ],
    "resources": [
      "icons/tray-macos-template.png",
      "resources/i18n/desktop.json",
      "resources/backend/nomoclaw.jar",
      "resources/backend/runtime"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://raw.githubusercontent.com/yoogooo/nomoclaw/refs/heads/dev/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
