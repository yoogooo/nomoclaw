{
  "name": "bot-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite",
    "check:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "build": "node scripts/check-i18n-keys.mjs && vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "lint:design-tokens": "node scripts/check-design-tokens.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "cronstrue": "^3.14.0",
    "dompurify": "^3.2.6",
    "katex": "^0.18.4",
    "lucide-vue-next": "^0.542.0",
    "markdown-it": "^14.1.0",
    "markdown-it-texmath": "^1.0.0",
    "naive-ui": "^2.42.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.5"
  }
}
